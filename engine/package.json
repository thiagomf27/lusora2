{
  "name": "@lusora/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "engine": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "catalog": "node --experimental-strip-types src/catalog/generate.ts write",
    "catalog:check": "node --experimental-strip-types src/catalog/generate.ts check"
  },
  "dependencies": {
    "@lusora/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
