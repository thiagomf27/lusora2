# lusora — one shared .env for platform + worker (D26). Copy to .env and fill.

# --- database ---
DATABASE_URL=postgres://lusora:lusora@localhost:5432/lusora

# --- platform ---
SESSION_SECRET=change-me-to-a-long-random-string
PLATFORM_PORT=3000
# initial admin (created by `pnpm db:seed` if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# --- data plane ---
VIDEOS_ROOT=./videos-data

# --- worker ---
WORKER_ID=worker-1
WORKER_POLL_SECONDS=3

# --- providers (secrets live here, never in the DB — D18) ---
# LLM
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# TTS (ai33 aggregator: edge/minimax/elevenlabs/kokoro voices)
AI33_API_KEY=
AI33_BASE_URL=https://api.ai33.pro
# stock
PEXELS_API_KEY=
# broll library service
LIBRARY_API_URL=http://localhost:8500
