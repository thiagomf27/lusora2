# lusora — one shared .env for platform + worker (D26). Copy to .env and fill.

# --- database ---
DATABASE_URL=postgres://lusora:lusora@localhost:5432/lusora

# --- platform ---
SESSION_SECRET=change-me-to-a-long-random-string
PLATFORM_PORT=3000
# initial admin (created by `pnpm db:seed` if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# --- data plane ---
VIDEOS_ROOT=./videos-data

# --- worker ---
# Unset or empty -> the hostname (unique per container). Set it only when
# running a worker by hand.
WORKER_ID=worker-1
WORKER_POLL_SECONDS=3
# How many calls of each kind run at once (D92) — machine and rate-limit
# settings, never channel settings. Defaults shown.
# ASSET_PARALLELISM=4
# PEXELS_CONCURRENCY=2
# OVERLAY_PARALLELISM=4
# TTS_PARALLELISM=6
# WHISPER_THREADS=4
# WHISPER_ALIGN_MODEL=base
# Renders allowed at once across ALL workers on this database (slice 6).
# RENDER_SLOTS=1
# docker compose only: how many worker containers.
# WORKER_REPLICAS=2

# --- providers (secrets live here, never in the DB — D18) ---
# LLM
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# TTS (ai33 aggregator: edge/minimax/elevenlabs/kokoro voices)
AI33_API_KEY=
AI33_BASE_URL=https://api.ai33.pro
# stock
PEXELS_API_KEY=
# broll library service
LIBRARY_API_URL=http://localhost:8321

# --- the library's own env (library/broll-engine/.env), set for THIS
# deployment. The library ships different defaults on purpose; these are the
# values lusora needs, and both are PERMANENT PER CLIP — sources are deleted
# after tagging, so changing either one later only affects footage ingested
# after the change. See docs/05-roadmap/broll-integration.md (D73).
#
# Frame-accurate cuts. The library defaults to "copy", which is faster and
# lossless but keyframe-snapped: the file physically holds the tail of the
# previous shot behind an MP4 edit list, and its container duration then
# disagrees with the duration on its own row (measured: 6.133 vs 6.000).
# That number is what degrade.py's short-clip fallback compares against.
# BROLL_CUT_MODE=reencode
#
# Clips are cut at the download resolution, and plans are built at 1920x1080
# (worker/lusora_worker/compiler/core.py). The library's 480 default is a
# 2.25x upscale on every library shot. Costs ~4-5x the disk per clip.
# BROLL_MAX_RES=1080
#
# NEVER /tmp: sources are deleted after tagging, so a reboot that clears it
# destroys the footage permanently and leaves rows pointing at nothing. This
# has already happened once — see docs/00-status.md.
# BROLL_CLIP_ROOT=./data/broll-store
