{
  "pack": "testpack",
  "components": [
    {
      "name": "TestCard",
      "pack": "testpack",
      "when_to_use": "in the test",
      "when_not_to_use": "in production",
      "anchor_types": [
        "number",
        "comparison"
      ],
      "props": {
        "value": {
          "type": "number",
          "required": true,
          "from_anchor": "value"
        },
        "label": {
          "type": "string",
          "maxWords": 8,
          "required": true
        },
        "prefix": {
          "type": "string",
          "maxWords": 2
        },
        "suffix": {
          "type": "string",
          "maxWords": 3
        },
        "emphasis": {
          "enum": [
            "accent",
            "neutral"
          ],
          "default": "accent"
        }
      },
      "duration_hint_s": {
        "min": 2.5,
        "default": 4
      },
      "renderer": "remotion",
      "template": "big_number"
    },
    {
      "name": "WarRoomPlate",
      "pack": "testpack",
      "when_to_use": "a command decision needs a plate naming the room and the hour",
      "when_not_to_use": "a person speaking (NamePlate); a document (DocumentCard)",
      "anchor_types": [
        "date"
      ],
      "props": {
        "text": {
          "type": "string",
          "maxWords": 8,
          "required": true,
          "from_anchor": "value"
        },
        "subtext": {
          "type": "string",
          "maxWords": 10
        },
        "side": {
          "enum": [
            "left",
            "right"
          ],
          "default": "left"
        },
        "emphasis": {
          "enum": [
            "accent",
            "neutral"
          ],
          "default": "accent"
        }
      },
      "duration_hint_s": {
        "min": 2,
        "default": 3.5
      },
      "renderer": "remotion",
      "template": "lower_third"
    }
  ]
}
