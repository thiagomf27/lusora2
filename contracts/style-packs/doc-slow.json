{
  "name": "doc-slow",
  "video_type": "doc",
  "pacing": {
    "avg_hold_seconds": 4.0,
    "min_hold": 2.5,
    "max_hold": 8.0,
    "arc": "three_act",
    "hold_floor_ratio": 1.0,
    "hold_ceiling_ratio": 1.5
  },
  "overlays": {
    "density": "normal",
    "allowed_packs": [
      "archive",
      "core"
    ]
  },
  "transitions": {
    "allowed": [
      "cut",
      "crossfade",
      "fade_to_black"
    ],
    "default": "cut"
  },
  "script_persona": "Grave, precise documentary narrator. Short sentences. No exclamations.",
  "visual_language": "Archival, desaturated, wide establishing shots; avoid modern footage.",
  "fallback": {
    "component": "ChapterCard",
    "text_prop": "title"
  },
  "sfx": {
    "enabled": false
  },
  "music": {
    "enabled": true,
    "min_span_s": 28,
    "crossfade_s": 2.5
  }
}
