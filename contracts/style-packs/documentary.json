{
  "name": "documentary",
  "video_type": "doc",
  "pacing": {
    "avg_hold_seconds": 4.0,
    "min_hold": 2.5,
    "max_hold": 8.0,
    "arc": "three_act",
    "hold_floor_ratio": 1.0,
    "hold_ceiling_ratio": 1.5,
    "hook": {
      "enabled": true,
      "mode": "headlines",
      "cut_s": 2.2,
      "min_hold": 1.5,
      "max_share": 0.25,
      "open_on": "footage",
      "title_card": { "enabled": true, "component": "KineticTitle", "seconds": 2.5, "lead_cue": "riser", "hit_cue": "hit" }
    },
    "rhythm": {
      "shot_s": 5,
      "max_still_s": 6,
      "snap_to_words": true,
      "min_graphic_gap_s": 2.0
    }
  },
  "overlays": {
    "density": "normal",
    "allowed_packs": [
      "basic",
      "core"
    ]
  },
  "captions": {
    "chunk": {
      "max_chars": 40,
      "max_words": 8
    }
  },
  "texture": {
    "placement": "narrative",
    "leak_min_gap_s": 12,
    "vintage_max_share": 0.33
  },
  "cta": {
    "enabled": true
  },
  "transitions": {
    "allowed": [
      "cut",
      "crossfade",
      "fade_to_black"
    ],
    "default": "cut",
    "animated_share": 0.15,
    "mix": {
      "crossfade": 1
    },
    "section_break": "fade_to_black",
    "durations": {
      "fade_to_black": 0.8
    }
  },
  "script_persona": "Grave, precise documentary narrator. Short sentences. No exclamations.",
  "visual_language": "Archival, desaturated, wide establishing shots; avoid modern footage.",
  "fallback": {
    "component": "ChapterCard",
    "text_prop": "title"
  },
  "sfx": {
    "enabled": true,
    "cues": [
      "entrance",
      "transition"
    ],
    "max_per_minute": 10,
    "min_gap_s": 0.9
  },
  "music": {
    "enabled": true,
    "min_span_s": 28,
    "crossfade_s": 2.5,
    "one_bed": true,
    "duck": "waveform",
    "under_voice_db": -28,
    "duck_db": 6,
    "hook_lift_db": 6,
    "hook_settle_s": 5,
    "loop_crossfade_s": 7
  },
  "mix": {
    "voice_lufs": -14,
    "master": "two_pass"
  }
}
