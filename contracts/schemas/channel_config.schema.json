{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lusora.dev/schemas/channel_config.schema.json",
  "title": "ChannelConfig",
  "description": "A channel's full config document, stored in channels.config, edited on the Channels screen. Per-video overrides deep-merge at enqueue (chain lists replace wholesale) into the immutable cfg.json snapshot.",
  "type": "object",
  "required": ["channel_id", "name", "language", "video_type", "theme", "style_pack", "voice", "source_policy"],
  "additionalProperties": false,
  "properties": {
    "channel_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2, "examples": ["pt-BR", "en-US"] },
    "video_type": { "enum": ["doc", "explainer", "breakdown", "listicle"] },
    "theme": { "type": "string", "description": "theme name (themes/<name>.yaml)" },
    "style_pack": { "type": "string", "description": "style pack name (style-packs/<name>.yaml)" },
    "component_pack": { "type": ["string", "null"], "default": null },
    "voice": {
      "type": "object",
      "required": ["provider"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "voice_id": { "type": "string" }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generator": { "type": "string", "default": "simple" },
        "llm": { "type": "string" }
      }
    },
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "llm": { "type": "string" }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "renderer": { "enum": ["auto", "ffmpeg", "remotion"], "default": "auto" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fps": { "type": "integer", "minimum": 1, "maximum": 120, "default": 30 },
        "width": { "type": "integer", "minimum": 16, "default": 1920 },
        "height": { "type": "integer", "minimum": 16, "default": 1080 }
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_usd_per_video"],
      "additionalProperties": false,
      "properties": {
        "max_usd_per_video": { "type": "number", "minimum": 0 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clips": { "enum": ["on_render", "on_posted", "keep"], "default": "on_render" },
        "final_mp4_days_after_posted": { "type": "integer", "minimum": 0, "default": 30 }
      }
    },
    "content_rules": { "type": "string", "description": "channel content rules text, given to the planner" },
    "source_policy": {
      "type": "object",
      "required": ["visual"],
      "additionalProperties": false,
      "properties": {
        "visual": {
          "type": "object",
          "required": ["chain"],
          "additionalProperties": false,
          "properties": {
            "chain": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/visualSource" },
              "description": "order = preference; omission = forbidden; replaced wholesale by overrides"
            },
            "max_clip_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 12 },
            "orientation": { "enum": ["landscape", "portrait", "square"], "default": "landscape" }
          }
        },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "chain": {
              "type": "array",
              "items": { "$ref": "#/$defs/audioSource" }
            },
            "default_volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.12 }
          }
        },
        "sfx": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "overrides": {
      "type": "object",
      "description": "per-video override slot (style pack fields like overlay density ride here in the snapshot)"
    },
    "style_pack_doc": {
      "type": "object",
      "description": "full style pack document embedded at enqueue (snapshot, Core Principle 7)"
    },
    "theme_doc": {
      "type": "object",
      "description": "full theme document embedded at enqueue (snapshot)"
    }
  },
  "$defs": {
    "visualSource": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["library", "stock", "ai_image"] },
        "media_types": {
          "type": "array",
          "items": { "enum": ["video_clip", "image", "video"] }
        },
        "profile": { "type": "string" },
        "include_global": { "type": "boolean", "default": true },
        "niches": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "licenses": {
          "type": "array",
          "items": { "enum": ["cc0", "cc-by", "cc-by-sa", "owned", "stock-licensed", "unknown"] }
        },
        "min_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "providers": { "type": "array", "items": { "type": "string" } },
        "provider": { "type": "string" },
        "style": { "type": "string", "description": "ai_image style suffix appended to the visual_intent" }
      }
    },
    "audioSource": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["audio_library"] },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
