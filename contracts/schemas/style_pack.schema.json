{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lusora.dev/schemas/style_pack.schema.json",
  "title": "StylePack",
  "description": "Behavior document, consumed by the PLANNER and the COMPILER. Pacing numbers are constraints, not advice.",
  "type": "object",
  "required": ["name", "pacing", "overlays", "transitions"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "video_type": {
      "enum": ["doc", "explainer", "breakdown", "listicle"],
      "description": "the video-type preset this pack implements; a channel's video_type picks among packs. Same enum as channel_config.video_type"
    },
    "pacing": {
      "type": "object",
      "required": ["avg_hold_seconds", "min_hold", "max_hold"],
      "additionalProperties": false,
      "properties": {
        "avg_hold_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "min_hold": { "type": "number", "exclusiveMinimum": 0 },
        "max_hold": { "type": "number", "exclusiveMinimum": 0 },
        "arc": { "enum": ["three_act", "linear", "listicle"], "default": "linear" }
      }
    },
    "overlays": {
      "type": "object",
      "required": ["density"],
      "additionalProperties": false,
      "properties": {
        "density": {
          "oneOf": [
            { "enum": ["low", "normal", "high"] },
            {
              "type": "object",
              "required": ["per_minute"],
              "additionalProperties": false,
              "properties": { "per_minute": { "type": "number", "minimum": 0 } }
            }
          ]
        },
        "allowed_components": {
          "type": "array",
          "items": { "type": "string" },
          "description": "planner menu filter AND validate rule (belt and suspenders)"
        }
      }
    },
    "transitions": {
      "type": "object",
      "required": ["allowed", "default"],
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["cut", "crossfade", "fade", "fade_to_black"] }
        },
        "default": { "enum": ["cut", "crossfade", "fade", "fade_to_black"] }
      }
    },
    "script_persona": { "type": "string", "description": "persona/style text for the script agent" },
    "visual_language": { "type": "string", "description": "visual guidance text for the beat planner" },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "description": "narration shape (D45): length lives with the pacing numbers it interacts with, and is overridable per video like overlays.density",
      "properties": {
        "target_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "target seconds of speech; the script prompt receives it as {{target_seconds}}"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.25,
          "description": "accepted deviation, as a fraction of target_seconds"
        },
        "prompt": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "prompt pack name carrying this pack's voice — layer 3 of the D44 resolution order"
        }
      }
    }
  }
}
