{
  "channel_id": "HIST_BR_01",
  "name": "Histórias da Guerra",
  "language": "pt-BR",
  "video_type": "doc",
  "theme": "history-dark",
  "style_pack": "doc-slow",
  "component_pack": null,
  "voice": { "provider": "mock", "voice_id": "default" },
  "script": { "generator": "simple", "llm": "deepseek" },
  "planner": { "llm": "deepseek" },
  "captions": { "enabled": true },
  "renderer": "auto",
  "output": { "fps": 30, "width": 1920, "height": 1080 },
