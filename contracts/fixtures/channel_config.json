          "min_score": 0.55
        },
        { "source": "stock", "providers": ["pexels"], "media_types": ["video"] },
        { "source": "ai_image", "provider": "mock", "style": "archival photo, desaturated, film grain" }
      ],
      "max_clip_seconds": 12,
      "orientation": "landscape",
      "dedup": { "reuse_window_items": 0, "min_hamming_distance": 6 }
    },
    "music": {
      "enabled": true,
      "chain": [{ "source": "audio_library", "tags": ["dark", "ambient"] }],
      "default_volume": 0.12
    },
    "sfx": { "enabled": false }
  }
}
