# Copy to .env (git-ignored) and fill in. broll/__init__.py loads it on import.

# --- GLM vision (hosted Z.ai; for local vLLM set base url to http://localhost:8000/v1) ---
ZAI_API_KEY=
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# GLM_MODEL=GLM-4.6V-Flash

# --- discovery sources ---
YOUTUBE_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- yt-dlp network identity: proxy + throwaway-account cookies travel together ---
# REQUIRED before any cold-path network call. Passed explicitly to every
# yt-dlp call AND to all discovery HTTP (YouTube Data API, storyboard sprites,
# Pexels/Pixabay) — the API key belongs to the same throwaway identity as the
# cookies, so keyed API calls must not leak the home IP either.
# Verify with: .venv/bin/python check_proxy.py
# Use "direct" only to explicitly allow traffic over your real IP.
YTDLP_PROXY=
# Cookies are OFF unless one of these is set. THROWAWAY account only — never
# a personal one (ban risk + identifies you despite the proxy).
# Either a browser profile ("chrome" or "chrome:Profile 2"; close the browser
# before runs), or an exported Netscape cookies.txt (takes precedence, keep it
# OUTSIDE the repo):
# BROLL_COOKIES_BROWSER=
# BROLL_COOKIES_FILE=/home/thiago/.config/broll/cookies.txt

# --- gallery profiles ---
# These define the "default" profile (named profiles live in
# ~/.config/broll/profiles.toml, path overridable via BROLL_PROFILES_FILE,
# and are managed on the UI Settings page).
# BROLL_DATABASE_URL=postgresql://broll:broll@localhost:5432/broll
# Where clip/thumbnail bytes live (the ObjectStore root).
# BROLL_STORAGE_ROOT=/tmp/broll_clips
# Embedding model + its output dimension. Per-profile because vectors from
# different models are incompatible; a mismatch against an existing database
# fails loudly.
# BROLL_EMBED_MODEL=all-MiniLM-L6-v2
# BROLL_EMBED_DIM=384
# BROLL_PROFILES_FILE=~/.config/broll/profiles.toml

# --- misc knobs ---
# BROLL_MAX_DURATION_S=
# Discovery skips videos shorter than this (default 240s = 4 min, which also
# makes the YouTube search itself exclude Shorts). Direct ingest.py links are
# never filtered.
# BROLL_MIN_DURATION_S=

# --- tunables (defaults shown) ---
# Download resolution cap, applied to the SHORTER video dimension.
# BROLL_MAX_RES=480
# Cosine similarity above which a new segment is linked as a near-duplicate.
# BROLL_DEDUP_SIM=0.93
# Segments shorter than this are never stored (no max cap at ingest —
# max duration is a search-time filter).
# BROLL_MIN_CLIP_S=4
# Ingest jobs are retried until they burn this many attempts.
# BROLL_JOB_MAX_ATTEMPTS=2
# Fine pass: chunk length / overlap for long videos, reply-token budget,
# and the segment length that triggers one refinement re-tag of the span.
# GLM_CHUNK_S=240
# GLM_CHUNK_OVERLAP_S=12
# GLM_FINE_MAX_TOKENS=12000
# GLM_REFINE_TRIGGER_S=18
# Unreported stretches longer than this get one re-tag call (0 disables).
# GLM_GAPFILL_MIN_S=45
# Client pacing: min seconds between GLM calls / retry attempts on 429-5xx.
# GLM_MIN_INTERVAL_S=3
# GLM_MAX_ATTEMPTS=7900
# GLM_MAX_VIDEO_MB=18
